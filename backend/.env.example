# CampusCore backend configuration — copy to .env and adjust. Never commit .env.
PORT=4000
NODE_ENV=development

# Relative file path (SQLite) or, later, a PostgreSQL connection string.
# The data layer reads only this variable, so swapping engines stays a config change.
DATABASE_URL=./campuscore.db

# REQUIRED in production — long random string.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=12h

# Academic Coach provider (optional). Leave AI_MODE=local for the built-in
# deterministic engine; no key required. Never hard-code keys in source.
AI_MODE=local
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
